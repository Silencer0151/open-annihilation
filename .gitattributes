# The licence texts are checked byte for byte against the ones their
# projects publish (tools/bootstrap_text_fonts.py), so every checkout keeps
# them exactly as committed, line endings included, whatever its own
# line-ending settings.
/licenses/** -text

# The automation protocol's test frames are compared byte for byte, line
# feeds and carriage returns included, so no checkout changes their line
# endings.
/src/app/automation/tests/vectors/*.bin -text
