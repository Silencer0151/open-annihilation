	zh-Hans=已锁定;
	}

[Hold to self-destruct]
	{
	zh-Hans=长按以自毁;
	}

[DOUBLE TAP OR HOLD TO BUILD · QUEUE ON]
	{
	zh-Hans=双击或长按以建造 · 排队已开启;
	}

[DOUBLE TAP OR HOLD TO BUILD]
	{
	zh-Hans=双击或长按以建造;
	}

[TAP POINTS · QUEUE KEEPS ADDING]
	{
	zh-Hans=点按各点 · 排队持续追加;
	}

[TAP A TARGET · ✕ TAKES IT BACK]
	{
	zh-Hans=点按目标 · ✕ 撤回;
	}

[TAP: {action}]
	{
	zh-Hans=点按：{action};
	}

[ENEMY: {action}]
	{
	zh-Hans=敌方：{action};
	}

[Place {name}]
	{
	zh-Hans=放置{name};
	}

[{order} armed]
	{
	zh-Hans={order}已启用;
	}

[Enable Unicode Multiplayer Chat]
	{
	zh-Hans=启用Unicode多人聊天;
	}

[Chat in any language with players who have it;]
	{
	zh-Hans=与开启此项的玩家可用任何语言聊天；;
	}

[others see ? for letters they lack.]
	{
	zh-Hans=其他玩家会把缺少的字看成?。;
	}

[Set by the language]
	{
	zh-Hans=由语言设定;
	}

[On (set by {language})]
	{
	zh-Hans=打开（由{language}设定）;
	}

// Network play's notices in the message log, with {slots} where the values go.
[Autopause: only the host can unpause]
	{
	zh-Hans=自动暂停：只有主持者可以继续游戏;
	}
[{player} tried to unpause.]
	{
	zh-Hans={player}试图继续游戏。;
	}
[{player} has cheats enabled]
	{
	zh-Hans={player}开启了作弊;
	}
[{player} reports VerCheck issues with {count} other players]
	{
	zh-Hans={player}报告{count}名其他玩家版本检查异常;
	}
[Vote: reject {player} ({yes} yes/{no} no/{voters}, {seconds}s)]
	{
	zh-Hans=投票：拒绝{player}（{yes}赞成/{no}反对/{voters}，{seconds}秒）;
	}
[Timeout: reject {player} ({yes} yes/{no} no/{voters}, {seconds}s)]
	{
	zh-Hans=超时：拒绝{player}（{yes}赞成/{no}反对/{voters}，{seconds}秒）;
	}
[{player} rejected]
	{
	zh-Hans={player}已被拒绝;
	}
[{player} stays in the game]
	{
	zh-Hans={player}留在游戏中;
	}
[Vote Yes or Vote No in the console answers the vote]
	{
	zh-Hans=在控制台输入Vote Yes或Vote No进行投票;
	}

// Whole sentences the engine fills in, with {slots} where the values go.
[Item {n}]
	{
	zh-Hans=第{n}项;
	}
[{on} of {total} on]
	{
	zh-Hans=已开启{on}/{total};
	}
[Show Active Only ({active}/{total})]
	{
	zh-Hans=仅显示已开启（{active}/{total}）;
	}
[Switch to {title} now? The game reloads its data for the new mod and returns to the main menu. Your other settings are kept.]
	{
	zh-Hans=现在切换到{title}吗？游戏将为新模组重新载入数据并返回主菜单。其他设置保持不变。;
	}
[This folder can be played: {folder}]
	{
	zh-Hans=此文件夹可以游玩：{folder};
	}
[{n} UNITS]
	{
	zh-Hans={n}个单位;
	}

// The game's title, as the game-files screen and the folder chooser name it.
[Total Annihilation]
	{
	zh-Hans=横扫千军;
	}
[Total Annihilation 3.1c]
	{
	zh-Hans=3.1c版横扫千军;
	}
